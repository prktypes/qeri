# Qeri API configuration (copied to .env — .env is git-ignored, never commit it)
# The OpenRouter key also exists ONLY here; it must never be reachable by the
# extension bundle or any client-side code.

# Required for live explanations (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Model id (OpenRouter slug). gpt-4o-mini: cheap, fast, supports strict
# JSON-schema responses. Change freely; cache keys are model-aware.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Port the extension's service worker talks to (host permission is scoped to
# http://localhost:8787/* in the extension manifest).
PORT=8787

# Safety rails while there is no account system yet (Phase 4 adds real auth):
# requests/day per server run, and requests/minute burst cap.
QUOTA_DAILY=40
RATE_LIMIT_PER_MINUTE=8

# In-memory explanation cache entry cap.
CACHE_MAX_ENTRIES=200
