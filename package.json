{
  "name": "qeri",
  "version": "0.3.0",
  "private": true,
  "description": "Qeri — AI that explains what you read. A Chrome extension that adds a lightweight understanding layer while you browse.",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:ext": "pnpm --filter qeri-extension dev",
    "build:ext": "pnpm --filter qeri-extension build",
    "zip:ext": "pnpm --filter qeri-extension zip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "pnpm --filter @qeri/api dev",
    "start:api": "pnpm --filter @qeri/api start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "happy-dom": "^20.0.10"
  }
}
